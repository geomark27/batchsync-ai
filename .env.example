# ─── SQL Server ────────────────────────────────────────────────────────────────
# Formato: sqlserver://user:password@host:1433?database=mydb
SQLSERVER_CONN_STRING="sqlserver://user:password@localhost:1433?database=batchsync"

# Pool de conexiones (opcionales, tienen defaults)
DB_MAX_OPEN_CONNS=50        # máximo de conexiones abiertas simultáneamente
DB_MAX_IDLE_CONNS=10        # conexiones en idle que se mantienen "calientes"
DB_CONN_MAX_LIFETIME=30m    # tiempo de vida de una conexión (formato Go: 30m, 1h, etc.)

# ─── Google Gemini ─────────────────────────────────────────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-api-key-here"

# ─── Parámetros de procesamiento (opcionales, tienen defaults) ─────────────────
# Registros por bloque enviado a Gemini en cada llamada.
BATCH_SIZE=20

# Goroutines concurrentes máximo hacia la API de Gemini.
MAX_WORKERS=50
